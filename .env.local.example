# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — never commit this, never put it in NEXT_PUBLIC_ vars, never send
# it to the browser. Only used in Server Actions (app/master/actions.ts) to
# create accounts. In Vercel, set this as an Environment Variable, not in code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
